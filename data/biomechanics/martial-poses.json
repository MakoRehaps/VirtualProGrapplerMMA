{
  "schema_version": 1,
  "description": "Source-backed biomechanical pose and motion profiles for procedural MAY' QUV animation. Measured values preserve study units; solver parameters are explicitly marked as derived or synthesized.",
  "coordinate_convention": {
    "forward": "+Z",
    "right": "+X",
    "up": "+Y",
    "joint_angle_degrees": "anatomical flexion/extension unless otherwise noted",
    "yaw_degrees": "positive rotates toward fighter's right",
    "normalized_time": "0=start, 1=end"
  },
  "solver_defaults": {
    "support_polygon_margin_m": 0.025,
    "max_foot_slide_m": 0.035,
    "ik_iterations": 8,
    "pelvis_follow_smoothing": 0.18,
    "torso_follow_smoothing": 0.14,
    "recovery_smoothing": 0.12
  },
  "formulas": {
    "knee_angle_from_leg_geometry": "acos(clamp((L1^2 + L2^2 - d^2) / (2*L1*L2), -1, 1))",
    "weighted_com_target": "sum(contact_position_i * support_weight_i) / sum(support_weight_i)",
    "balance_error": "distance(project(COM, ground), nearest_point_on_support_polygon)",
    "segment_tip_velocity": "parent_linear_velocity + cross(angular_velocity, segment_radius_vector)",
    "normalized_stride": "stance_length_m / fighter_height_m",
    "normalized_width": "stance_width_m / pelvis_width_m"
  },
  "sources": [
    {

  "derived_formulas": {
    "movement_acceleration": "base_accel * stance.forward_factor * pow(reference_mass_kg / mass_kg, acceleration_mass_exponent)",
    "pivot_rate": "base_pivot * stance.pivot_factor / (1 + rotational_inertia)",
    "push_resistance": "pow(mass_kg / reference_mass_kg, push_resistance_mass_exponent) * balance_state",
    "effective_strike_mass": "mass_kg * limb_transfer_ratio * technique_transfer * stance_transfer",
    "impact_energy": "0.5 * effective_strike_mass * relative_contact_velocity_mps^2",
    "collision_impulse": "effective_mass_kg * relative_velocity_mps",
    "hp_damage": "normalize(event_energy * target_modifier * contact_quality)",
    "note": "These are simulation formulas/tuning hooks, not exposed RPG attributes."
  }

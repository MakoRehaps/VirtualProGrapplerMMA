{
  "schema_version": 1,
  "description": "Continuous competitive body simulation. There are no weight classes; every legal fighter is evaluated on one continuous physics curve.",
  "invariants": {
    "hp_max": 100,
    "stamina_max": 100,
    "consciousness_max": 100,
    "balance_max": 100,
    "selectable_power_stats": false,
    "visible_numeric_stats": false,
    "practice_changes_stats": false,
    "weight_classes": false
  },
  "legal_body_envelope": {
    "min_mass_kg": 45,
    "max_mass_kg": 160,
    "min_height_m": 1.5,
    "max_height_m": 2.1,
    "min_reach_to_height_ratio": 0.9,
    "max_reach_to_height_ratio": 1.12,
    "center_of_mass_height_ratio": {
      "min": 0.52,
      "max": 0.62
    }
  },
  "reference_body": {
    "mass_kg": 77,
    "height_m": 1.78,
    "reach_m": 1.81
  },
  "physics": {
    "acceleration_mass_exponent": 0.28,
    "deceleration_mass_exponent": 0.24,
    "rotational_inertia_mass_exponent": 0.42,
    "push_resistance_mass_exponent": 0.7,
    "impact_effective_mass_exponent": 0.55,
    "stamina_movement_mass_exponent": 0.22,
    "height_stride_exponent": 0.12,
    "height_balance_exponent": 0.1
  },
  "derived_formulas": {
    "movement_acceleration": "base_accel * stance.forward_factor * pow(reference_mass_kg / mass_kg, acceleration_mass_exponent)",
    "pivot_rate": "base_pivot * stance.pivot_factor / pow(mass_kg / reference_mass_kg, rotational_inertia_mass_exponent)",
    "push_resistance": "pow(mass_kg / reference_mass_kg, push_resistance_mass_exponent) * balance_state",
    "stride_scale": "pow(height_m / reference_height_m, height_stride_exponent)",
    "balance_height_scale": "pow(reference_height_m / height_m, height_balance_exponent)",
    "effective_strike_mass": "mass_kg * limb_transfer_ratio * technique_transfer * stance_transfer",
    "impact_energy": "0.5 * effective_strike_mass * relative_contact_velocity_mps^2",
    "collision_impulse": "effective_mass_kg * relative_velocity_mps",
    "hp_damage": "normalize(event_energy * target_modifier * contact_quality)",
    "note": "Body dimensions affect physics continuously. They never assign a fighter to a class or grant RPG stats."
  }
}

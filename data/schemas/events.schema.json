{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "uses_physics",
          "can_damage_hp",
          "resolution"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "uses_physics": {
            "type": "boolean"
          },
          "can_damage_hp": {
            "type": "boolean"
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    }
  }
}

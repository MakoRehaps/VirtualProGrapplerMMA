{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "season",
    "modes",
    "weekly_event",
    "monthly_event"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "season": {
      "type": "object"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mode_id",
          "name",
          "opponent_pool",
          "ruleset_id",
          "damage_persistence",
          "earns_tokens",
          "affects_rank"
        ],
        "properties": {
          "mode_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "opponent_pool": {
            "type": "string"
          },
          "ruleset_id": {
            "type": "string"
          },
          "damage_persistence": {
            "type": "string"
          },
          "earns_tokens": {
            "type": "boolean"
          },
          "affects_rank": {
            "type": "boolean"
          }
        }
      }
    },
    "weekly_event": {
      "type": "object"
    },
    "monthly_event": {
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "difficulty_levels",
    "qualifier_templates",
    "fairness"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "difficulty_levels": {
      "type": "array",
      "minItems": 1
    },
    "qualifier_templates": {
      "type": "array",
      "minItems": 1
    },
    "fairness": {
      "type": "object",
      "properties": {
        "same_hp": {
          "const": true
        },
        "same_stamina": {
          "const": true
        },
        "future_input_reading": {
          "const": false
        },
        "hidden_stat_bonus": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "invariants",
    "legal_body_envelope",
    "reference_body",
    "physics",
    "derived_formulas"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "invariants": {
      "type": "object",
      "required": [
        "hp_max",
        "stamina_max",
        "consciousness_max",
        "balance_max",
        "selectable_power_stats",
        "visible_numeric_stats",
        "practice_changes_stats",
        "weight_classes"
      ],
      "properties": {
        "hp_max": {
          "const": 100
        },
        "stamina_max": {
          "const": 100
        },
        "consciousness_max": {
          "const": 100
        },
        "balance_max": {
          "const": 100
        },
        "selectable_power_stats": {
          "const": false
        },
        "visible_numeric_stats": {
          "const": false
        },
        "practice_changes_stats": {
          "const": false
        },
        "weight_classes": {
          "const": false
        }
      }
    },
    "legal_body_envelope": {
      "type": "object",
      "required": [
        "min_mass_kg",
        "max_mass_kg",
        "min_height_m",
        "max_height_m",
        "min_reach_to_height_ratio",
        "max_reach_to_height_ratio",
        "center_of_mass_height_ratio"
      ],
      "properties": {
        "min_mass_kg": {
          "type": "number",
          "minimum": 30
        },
        "max_mass_kg": {
          "type": "number",
          "maximum": 250
        },
        "min_height_m": {
          "type": "number",
          "minimum": 1.2
        },
        "max_height_m": {
          "type": "number",
          "maximum": 2.5
        },
        "min_reach_to_height_ratio": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        },
        "max_reach_to_height_ratio": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.3
        },
        "center_of_mass_height_ratio": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "reference_body": {
      "type": "object"
    },
    "physics": {
      "type": "object"
    },
    "derived_formulas": {
      "type": "object"
    }
  }
}

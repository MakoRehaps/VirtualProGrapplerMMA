{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "invariants",
    "body_classes",
    "derived_formulas"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "invariants": {
      "type": "object",
      "required": [
        "hp_max",
        "stamina_max",
        "consciousness_max",
        "balance_max",
        "selectable_power_stats",
        "visible_numeric_stats",
        "practice_changes_stats"
      ],
      "properties": {
        "hp_max": {
          "const": 100
        },
        "stamina_max": {
          "const": 100
        },
        "consciousness_max": {
          "const": 100
        },
        "balance_max": {
          "const": 100
        },
        "selectable_power_stats": {
          "const": false
        },
        "visible_numeric_stats": {
          "const": false
        },
        "practice_changes_stats": {
          "const": false
        }
      }
    },
    "body_classes": {
      "type": "array",
      "minItems": 1
    },
    "derived_formulas": {
      "type": "object"
    }
  }
}

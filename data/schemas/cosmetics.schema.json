{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "categories",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "tier",
          "token_cost",
          "requirement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "token_cost": {
            "type": "integer",
            "minimum": 0
          },
          "requirement": {
            "type": "string"
          }
        }
      }
    }
  }
}

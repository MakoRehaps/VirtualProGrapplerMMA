{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "transition_id",
          "from",
          "to",
          "type",
          "difficulty",
          "stamina_cost"
        ],
        "additionalProperties": false,
        "properties": {
          "transition_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "stamina_cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "rulesets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rulesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ruleset_id",
          "name",
          "players",
          "team_size",
          "hp_max",
          "normal_tko",
          "finishes",
          "platform",
          "damage_persists_between_matches"
        ],
        "properties": {
          "ruleset_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "players": {
            "const": 2
          },
          "team_size": {
            "const": 1
          },
          "hp_max": {
            "const": 100
          },
          "normal_tko": {
            "const": false
          },
          "finishes": {
            "type": "array"
          },
          "platform": {
            "type": "string"
          },
          "damage_persists_between_matches": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
